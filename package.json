{
  "name": "9meta",
  "version": "2.5.37",
  "description": "Nhà Yến Zalo - Quản lý nhiều tài khoản, người dùng và nhóm Zalo trên Desktop.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:electron-unfriend": "electron test/electron-unfriend-detached-smoke.js",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.nhayen.zalo",
    "productName": "Nhà Yến Zalo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "update-notice.html",
      "custom_style.css",
      "modules/**/*.js",
      "icon.ico",
      "icon.png",
      "brand-logo.png",
      "assets/fonts/Quicksand-VariableFont_wght.ttf",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Nhà Yến Zalo",
      "artifactName": "Nha-Yen-Zalo-Setup-${version}.${ext}"
    },
    "releaseInfo": {
      "releaseNotes": "Pancake: sửa khối sản phẩm thẳng hàng cột, to số tiền cột Thành tiền, thu nhỏ nút xoá."
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thaophamce",
        "repo": "nhayen-zalo-updates"
      }
    ]
  },
  "author": "Tiodev71",
  "license": "MIT",
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "cloudflared": "^0.7.3",
    "electron-updater": "^6.8.3",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "allowScripts": {
    "electron@29.4.6": true
  }
}
